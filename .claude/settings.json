{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "cd $(git rev-parse --show-toplevel) && python3 .claude/hooks/safety_guard.py",
            "statusMessage": "Checking for destructive commands..."
          }
        ]
      },
      {
        "matcher": "Edit",
        "hooks": [
          {
            "type": "command",
            "command": "cd $(git rev-parse --show-toplevel) && python3 .claude/hooks/read_guard.py",
            "statusMessage": "Checking file was read before edit..."
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Read",
        "hooks": [
          {
            "type": "command",
            "command": "python3 .claude/hooks/read_guard.py"
          }
        ]
      }
    ]
  }
}
